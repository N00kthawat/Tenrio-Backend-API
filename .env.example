# PostgreSQL database
PORT=4000
DB_HOST=localhost
DB_PORT=5435
DB_USER=postgres
DB_PASSWORD=YOUR_PASSWORD
DB_NAME=tenrio_dev
DB_SSL=false

# URL-encode special characters in the password when building DATABASE_URL.
# Example: if the password contains "@", use "%40" in DATABASE_URL.
DATABASE_URL="postgresql://postgres:YOUR_URL_ENCODED_PASSWORD@localhost:5435/tenrio_dev?schema=public"

# Email
RESEND_API_KEY=YOUR_RESEND_API_KEY
EMAIL_FROM="Tenrio <no-reply@example.com>"
CUSTOMER_WEB_URL=http://localhost:3000
